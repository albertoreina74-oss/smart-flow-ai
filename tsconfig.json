{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // `*.test.ts` files run on Node's built-in test runner, whose ESM resolver
    // requires the file extension in relative imports. Metro never sees these
    // files (nothing in the app imports them), so this only affects tests.
    "allowImportingTsExtensions": true
  }
}
